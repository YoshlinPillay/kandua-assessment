# Copy to terraform.tfvars (gitignored) and fill in. Only non-secret settings: secrets are generated by
# Terraform or managed by AWS (the RDS master password lives in Secrets Manager).
alert_email = "you@example.com" # AWS Budgets alerts (USD 20/month)
admin_email = "you@example.com" # your Lightdash admin login (invite link generated on deploy)

# Optional overrides
# db_public_cidrs    = ["0.0.0.0/0"] # reviewer DB access (TLS enforced); narrow to an allowlist if preferred
# instance_type      = "t3.large"
# monthly_budget_usd = 20
