.env
.env.*
!.env.example
*.pem
*.key

# Terraform state / local artefacts
**/.terraform/
*.tfstate
*.tfstate.*
*.tfplan
crash.log

# Python
.venv/
__pycache__/
*.pyc
.pytest_cache/
.ruff_cache/

