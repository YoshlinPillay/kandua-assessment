# Copy to .env and replace every "changeme". .env is gitignored and the agent is not allowed to read it.

# Warehouse (Postgres). Locally this is the compose service; on AWS it is RDS.
POSTGRES_HOST=localhost
POSTGRES_PORT=5433
POSTGRES_DB=juan
POSTGRES_ADMIN_USER=juan_admin
POSTGRES_ADMIN_PASSWORD=changeme
# Read-only role for BI, Cube and reviewers (SELECT on core + marts only)
POSTGRES_READER_USER=juan_reader
POSTGRES_READER_PASSWORD=changeme

# Lightdash (BI). Generate secrets with: openssl rand -hex 32
LIGHTDASH_SECRET=changeme
LIGHTDASH_DB_PASSWORD=changeme
LIGHTDASH_SITE_URL=http://localhost:8100
MINIO_ROOT_PASSWORD=changeme
# Lightdash personal access token for the CLI (create in the Lightdash UI: Settings → Personal access tokens)
LIGHTDASH_API_KEY=changeme

# Cube (semantic layer API for the chat app)
CUBEJS_API_SECRET=changeme

# Chat app: Amazon Bedrock (D-020/D-021). Credentials come from the standard AWS chain (~/.aws or IAM role).
BEDROCK_REGION=us-east-1
AWS_PROFILE=default
